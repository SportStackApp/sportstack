# SportStack frontend environment variables
# Copy this file to .env.local and fill the values from the project owner.
# Do not commit .env.local or any real secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Public Cloudflare Turnstile widget identifier. This is safe in browser code.
VITE_UMPIRE_TURNSTILE_SITE_KEY=

# Server/CI only — do not expose in frontend code or VITE_ variables.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=
# PUBLIC_UMPIRE_PORTAL_ENABLED=false
# PUBLIC_UMPIRE_ASSOCIATION_ID=
# PUBLIC_UMPIRE_ALLOWED_ORIGINS=
