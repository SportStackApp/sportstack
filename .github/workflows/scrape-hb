# .github/workflows/scrape-hb.yml

name: Scrape — Hockey Ballarat

on:
  workflow_dispatch:
    inputs:
      only_grades:
        description: 'Grades to scrape (comma-separated, blank = all)'
        required: false
        default: ''
      only_rounds:
        description: 'Rounds to scrape (comma-separated, blank = all)'
        required: false
        default: ''
      only_team:
        description: 'Team name filter (partial match, blank = all)'
        required: false
        default: ''

jobs:
  scrape:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install requests beautifulsoup4 supabase

      - name: Run scraper
        env:
          PORTAL_URL: "https://www.revolutionise.com.au/hockeyballarat"
          ASSOCIATION_NAME: "Hockey Ballarat"
          OUTPUT_DIR: "data/hockey-ballarat"
          UPSERT_SUPABASE: "false"
          ONLY_GRADES: ${{ github.event.inputs.only_grades || '' }}
          ONLY_ROUNDS: ${{ github.event.inputs.only_rounds || '' }}
          ONLY_TEAM: ${{ github.event.inputs.only_team || '' }}
        run: python scraper/scraper.py

      - name: Commit Hockey Ballarat output
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

          git add data/hockey-ballarat

          if git diff --cached --quiet; then
            echo "No Hockey Ballarat output changes to commit."
          else
            git commit -m "scrape(hb): latest output"
            git pull --rebase -X theirs
            git push
          fi
